---
// src/pages/index.astro
---

<!DOCTYPE html>
<html lang="zh-cn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>遇见你真好</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <style is:global>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            transition: background-color 0.6s ease, color 0.6s ease, filter 0.6s ease;
        }

        html, body {
            height: 100%;
            overflow: hidden;
            font-family: 'JetBrains Mono', monospace;
            -webkit-font-smoothing: antialiased;
        }

        body.day-mode {
            background-color: #fef9f0;
            color: #5a4a3a;
        }

        body.night-mode {
            background-color: #0f0f23;
            color: #e6d5c3;
        }

        #__next {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* 星空层（仅夜间） */
        .stars {
            position: absolute;
            inset: 0;
            pointer-events: none;
            opacity: 0;
            transition: opacity 1s ease;
            z-index: 1;
        }

        body.night-mode .stars {
            opacity: 1;
        }

        .star {
            position: absolute;
            background-color: white;
            border-radius: 50%;
            animation: twinkle 3s infinite ease-in-out;
        }

        .star-hex {
            position: absolute;
            width: 12px;
            height: 12px;
            filter: drop-shadow(0 0 2px white);
            animation: hexTwinkle 5s infinite ease-in-out;
        }

        @keyframes twinkle {
            0%, 100% { opacity: 0.2; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.2); }
        }

        @keyframes hexTwinkle {
            0%, 100% { opacity: 0.2; transform: scale(1) rotate(0deg); }
            50% { opacity: 1; transform: scale(1.3) rotate(60deg); }
        }

        /* 流星 */
        .meteor-shower {
            position: absolute;
            inset: 0;
            pointer-events: none;
            opacity: 0;
            transition: opacity 1s ease;
            z-index: 2;
        }

        body.night-mode .meteor-shower {
            opacity: 1;
        }

        .meteor {
            position: absolute;
            top: -100px;
            left: -100px;
            width: 150px;
            height: 2px;
            background: linear-gradient(
                90deg,
                rgba(255,255,255,0) 0%,
                rgba(255,255,255,.8) 50%,
                rgba(255,255,255,0) 100%
            );
            transform: rotate(45deg);
            animation: meteorDiagonal 5s ease-in-out infinite;
            animation-delay: 10s;
            filter: blur(.5px);
            box-shadow: 0 0 10px 1px rgba(255,255,255,.3);
        }

        @keyframes meteorDiagonal {
            0% {
                transform: translate(-200px, -200px) rotate(45deg);
                opacity: 0;
            }
            10%, 90% { opacity: 1; }
            100% {
                transform: translate(calc(100vw + 200px), calc(100vh + 200px)) rotate(45deg);
                opacity: 0;
            }
        }

        .overlay {
            position: absolute;
            inset: 0;
            pointer-events: none;
            z-index: 3;
        }

        body.day-mode .overlay {
            background: linear-gradient(
                180deg,
                rgba(255,200,150,.1) 0%,
                transparent 30%,
                transparent 70%,
                rgba(255,230,200,.1) 100%
            );
        }

        body.night-mode .overlay {
            background: linear-gradient(
                180deg,
                rgba(0,0,0,.3) 0%,
                transparent 30%,
                transparent 70%,
                rgba(0,0,0,.3) 100%
            );
        }

        .container {
            position: relative;
            z-index: 10;
            height: 100%;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .theme-toggle {
            background: none;
            border: none;
            color: inherit;
            cursor: pointer;
            display: flex;
            align-items: center;
        }

        .theme-toggle svg {
            width: 22px;
            height: 22px;
            transition: transform .6s ease;
        }

        .theme-toggle:active svg {
            transform: rotate(180deg) scale(.9);
        }

        .scene {
            position: absolute;
            inset: 0;
            display: grid;
            place-items: center;
        }

        .hello-text {
            font-size: clamp(48px, 10vw, 120px);
            font-weight: 500;
        }

        body.day-mode .hello-text {
            color: #5a4a3a;
            text-shadow: 2px 2px 10px rgba(0,0,0,.15);
        }

        body.night-mode .hello-text {
            color: #f5e6d3;
            text-shadow: 0 0 20px rgba(245,230,211,.3);
        }

        .bottom-bar {
            display: flex;
            justify-content: space-between;
            font-size: 14px;
        }

        @media (max-width: 768px) {
            .container { padding: 20px; }
            .top-bar, .bottom-bar { font-size: 12px; }
        }
    </style>
</head>

<body class="day-mode">
    <div id="__next">
        <div class="stars" id="stars"></div>
        <div class="meteor-shower"><div class="meteor"></div></div>
        <div class="overlay"></div>

        <div class="container">
            <div class="top-bar">
                <div>📅 day by days</div>
                <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle Theme">
                    <svg id="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                        <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
                    </svg>
                </button>
            </div>

            <div class="scene">
                <div class="hello-text">遇见你真好</div>
            </div>

            <div class="bottom-bar">
                <div>❤️ <span id="site-days-counter">0 天</span></div>
                <div id="current-time">9:26:26 pm</div>
            </div>
        </div>
    </div>

    <script>
        function createStars() {
            const c = document.getElementById('stars');
            for (let i = 0; i < 80; i++) {
                const s = document.createElement('div');
                const hex = Math.random() > 0.5;
                s.className = hex ? 'star-hex' : 'star';
                s.style.cssText = `
                    left:${Math.random()*100}%;
                    top:${Math.random()*100}%;
                    animation-delay:${Math.random()*5}s;
                `;
                if (hex) {
                    s.innerHTML = `<svg viewBox="0 0 24 24" fill="white"><polygon points="12,2 15,9 22,9 16,14 18,21 12,17 6,21 8,14 2,9 9,9"/></svg>`;
                }
                c.appendChild(s);
            }
        }

        function updateSiteDays() {
            const d = Math.floor((Date.now() - new Date('2018-11-11')) / 864e5);
            document.getElementById('site-days-counter').textContent = d + ' 天';
        }

        function toggleTheme() {
            const body = document.body;
            const icon = document.getElementById('theme-icon');
            const night = body.classList.contains('day-mode');

            body.classList.replace(night ? 'day-mode' : 'night-mode', night ? 'night-mode' : 'day-mode');

            icon.innerHTML = night
                ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                       <circle cx="12" cy="12" r="5"/>
                       <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                   </svg>`
                : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                       <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
                   </svg>`;
        }

        function updateTime() {
            const now = new Date();
            let h = now.getHours();
            const m = String(now.getMinutes()).padStart(2,'0');
            const s = String(now.getSeconds()).padStart(2,'0');
            const ampm = h >= 12 ? 'pm' : 'am';
            h = h % 12 || 12;
            document.getElementById('current-time').textContent = `${h}:${m}:${s} ${ampm}`;
        }

        createStars();
        updateSiteDays();
        updateTime();
        setInterval(updateTime, 1000);
    </script>
</body>
</html>
