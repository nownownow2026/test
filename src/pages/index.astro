---
// src/pages/index.astro
---

<!DOCTYPE html>
<html lang="zh-cn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>遇见你真好</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <style is:global>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            transition: background-color 0.6s ease, color 0.6s ease, filter 0.6s ease;
        }

        html, body {
            height: 100%;
            overflow: hidden;
            font-family: 'JetBrains Mono', monospace;
            -webkit-font-smoothing: antialiased;
        }

        body.day-mode {
            background-color: #fef9f0;
            color: #5a4a3a;
        }

        body.night-mode {
            background-color: #0f0f23;
            color: #e6d5c3;
        }

        #__next {
            position: relative;
            width: 100vw;
            height: 100vh;
            display: flex;
            flex-direction: column;
            background-image: url('/1.web');
            background-size: cover;
            background-position: center;
        }

        body.day-mode #__next {
            filter: sepia(15%) brightness(1.05) saturate(1.1);
        }

        body.night-mode #__next {
            filter: brightness(0.6) contrast(1.2);
        }

        /* 星空层 */
        .stars {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            opacity: 0;
            transition: opacity 1s ease;
        }
        body.night-mode .stars {
            opacity: 1;
        }
        
        /* 普通点状星星 */
        .star {
            position: absolute;
            background-color: white;
            border-radius: 50%;
            animation: twinkle 3s infinite ease-in-out;
        }
        
        /* 真正的六角星 (使用 SVG 绘制，形状最完美) */
        .star-hex {
            position: absolute;
            width: 12px;
            height: 12px;
            animation: hexTwinkle 5s infinite ease-in-out;
            filter: drop-shadow(0 0 2px white);
        }

        @keyframes twinkle {
            0%, 100% { opacity: 0.2; transform: scale(1); }
            50% { opacity: 0.8; transform: scale(1.2); }
        }
        
        @keyframes hexTwinkle {
            0%, 100% { opacity: 0.2; transform: scale(1) rotate(0deg); }
            50% { opacity: 1; transform: scale(1.3) rotate(60deg); }
        }

        /* 流星层 */
        .meteor-shower {
            position: absolute;
            width: 100%;
            height: 100%;
            pointer-events: none;
            overflow: hidden;
            opacity: 0;
            transition: opacity 1s ease;
        }
        body.night-mode .meteor-shower {
            opacity: 1;
        }
        
        .meteor {
            position: absolute;
            top: -100px;
            left: -100px;
            width: 150px;
            height: 2px;
            background: linear-gradient(90deg, 
                rgba(255, 255, 255, 0) 0%, 
                rgba(255, 255, 255, 0.8) 50%, 
                rgba(255, 255, 255, 0) 100%);
            transform: rotate(45deg);
            transform-origin: 0 0;
            animation: meteorDiagonal 5s ease-in-out infinite;
            animation-delay: 10s;
            border-radius: 50%;
            filter: blur(0.5px);
            box-shadow: 0 0 10px 1px rgba(255, 255, 255, 0.3);
        }

        @keyframes meteorDiagonal {
            0% {
                transform: translateX(-200px) translateY(-200px) rotate(45deg);
                opacity: 0;
            }
            10% {
                opacity: 1;
            }
            90% {
                opacity: 1;
            }
            100% {
                transform: translateX(calc(100vw + 200px)) translateY(calc(100vh + 200px)) rotate(45deg);
                opacity: 0;
            }
        }

        .overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        body.day-mode .overlay {
            background: linear-gradient(180deg, rgba(255,200,150,.1) 0%, transparent 30%, transparent 70%, rgba(255,230,200,.1) 100%);
        }

        body.night-mode .overlay {
            background: linear-gradient(180deg, rgba(0,0,0,.3) 0%, transparent 30%, transparent 70%, rgba(0,0,0,.3) 100%);
        }

        .container {
            position: relative;
            z-index: 10;
            padding: 40px;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            font-size: 14px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0;
        }

        .climate-info {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .theme-toggle {
            cursor: pointer;
            padding: 0;
            background: transparent;
            border: none;
            color: inherit;
            display: flex;
            align-items: center;
            justify-content: center;
            outline: none;
        }

        .theme-toggle:hover {
            transform: scale(1.15);
        }

        .theme-toggle svg {
            transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            transform-origin: center center;
            width: 22px;
            height: 22px;
        }
        .theme-toggle:active svg {
            transform: rotate(180deg) scale(0.9);
        }

        .scene {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 80%;
            max-width: 800px;
            aspect-ratio: 16 / 9;
            background-image: url('/1.web');
            background-repeat: no-repeat;
            background-position: center;
            background-size: contain;
            opacity: 0.95;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hello-text {
            font-size: clamp(48px, 10vw, 120px);
            font-weight: 500;
            letter-spacing: 2px;
        }

        body.day-mode .hello-text {
            color: #5a4a3a;
            text-shadow: 2px 2px 10px rgba(0, 0, 0, 0.15);
        }

        body.night-mode .hello-text {
            color: #f5e6d3;
            text-shadow: 0 0 20px rgba(245, 230, 211, 0.3);
        }

        .bottom-bar {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            font-size: 14px;
            font-weight: 500;
        }

        .site-days {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .time {
            font-feature-settings: "tnum";
            letter-spacing: 1px;
        }

        @media (max-width: 768px) {
            .container {
                padding: 20px;
            }
            .bottom-bar, .top-bar {
                font-size: 12px;
            }
        }
    </style>
</head>
<body class="day-mode">
    <div id="__next">
        <!-- 背景效果层 -->
        <div class="stars" id="stars"></div>
        <div class="meteor-shower">
            <div class="meteor"></div>
        </div>
        <div class="overlay"></div>
        
        <div class="container">
            <!-- 左上角 -->
            <div class="top-bar">
                <div class="climate-info">
                    <span>📅</span>
                    <span>day by days</span>
                </div>
                <!-- 右上角 -->
                <button class="theme-toggle" onclick="toggleTheme()" aria-label="Toggle Theme">
                    <svg id="theme-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                        <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
                    </svg>
                </button>
            </div>

            <!-- 中间文字 -->
            <div class="scene">
                <div class="hello-text">遇见你真好</div>
            </div>

            <!-- 左下角 -->
            <div class="bottom-bar">
                <div class="site-days">
                    <span>❤️</span>
                    <span id="site-days-counter">0 天</span>
                </div>
                <div class="time">
                    <span id="current-time">9:26:26 pm</span>
                </div>
            </div>
        </div>
    </div>

    <script>
        function createStars() {
            const starsContainer = document.getElementById('stars');
            const starTypes = ['star', 'star-hex']; 
            
            for (let i = 0; i < 80; i++) {
                const star = document.createElement('div');
                const typeIndex = Math.floor(Math.random() * starTypes.length);
                star.className = starTypes[typeIndex];
                
                const size = Math.random() * 2 + 1;
                star.style.width = `${size}px`;
                star.style.height = `${size}px`;
                star.style.left = `${Math.random() * 100}%`;
                star.style.top = `${Math.random() * 100}%`;
                star.style.animationDelay = `${Math.random() * 5}s`;
                
                if (typeIndex === 0) {
                    star.style.opacity = Math.random() * 0.5 + 0.2;
                } else {
                    star.innerHTML = `
                        <svg viewBox="0 0 24 24" fill="white" width="100%" height="100%">
                            <polygon points="12,2 15,9 22,9 16,14 18,21 12,17 6,21 8,14 2,9 9,9"/>
                        </svg>
                    `;
                    star.style.opacity = Math.random() * 0.5 + 0.3;
                }
                
                starsContainer.appendChild(star);
            }
        }

        function updateSiteDays() {
            const launchDate = new Date('2018-11-11');
            const today = new Date();
            const diffTime = today - launchDate;
            const diffDays = Math.floor(diffTime / (1000 * 60 * 60 * 24));
            
            document.getElementById('site-days-counter').textContent = 
                `${Math.max(0, diffDays)} 天`;
        }

        function toggleTheme() {
            const body = document.body;
            const iconContainer = document.getElementById('theme-icon');
            
            if (body.classList.contains('day-mode')) {
                body.classList.replace('day-mode', 'night-mode');
                iconContainer.innerHTML = `
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                        <circle cx="12" cy="12" r="5"/>
                        <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>
                    </svg>
                `;
            } else {
                body.classList.replace('night-mode', 'day-mode');
                iconContainer.innerHTML = `
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                        <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
                    </svg>
                `;
            }
        }

        function updateTime() {
            const now = new Date();
            let hours = now.getHours();
            const minutes = String(now.getMinutes()).padStart(2, '0');
            const seconds = String(now.getSeconds()).padStart(2, '0');
            const ampm = hours >= 12 ? 'pm' : 'am';
            
            hours = hours % 12;
            hours = hours ? hours : 12;
            
            document.getElementById('current-time').textContent = 
                `${hours}:${minutes}:${seconds} ${ampm}`;
        }

        createStars();
        updateSiteDays();
        updateTime();
        setInterval(updateTime, 1000);
    </script>
</body>
</html>
